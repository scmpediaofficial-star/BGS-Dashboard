# Supabase project settings (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Absolute deployment origin, without a trailing slash
NEXT_PUBLIC_SITE_URL=https://dashboard.example.com

# Use a stable random value across deployments. Rotating it invalidates saved
# social credentials and outstanding invite/reset links.
ENCRYPTION_KEY=
CRON_SECRET=
SETUP_SECRET=

# Resend: verify a domain, then use an address on that domain.
RESEND_API_KEY=
EMAIL_FROM="BGS Dashboard <alerts@example.com>"
EMAIL_REPLY_TO=info@boardroomgovsummit.com

# Web Push. Generate a pair with: node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@boardroomgovsummit.com
